;; A component's core module that reads WASI's INSECURE entropy and returns it as JSON, so a test can compare what a guest sees across replays.
;; wasi:random/insecure and wasi:random/insecure-seed are the two entropy interfaces cleat shadows and nothing used to exercise (cleat#4396).
;; @VERSION@ is substituted by build.sh: one component per WASI 0.2 minor, as probe.wat.tmpl is (cleat#4078).
;;
;;   i = get-insecure-random-u64                        s, t = the two halves of insecure-seed (a tuple<u64,u64>, returned through a pointer)
;;   b = the first 8 bytes of get-insecure-random-bytes(8)
(module
  (import "wasi:random/insecure@@VERSION@" "get-insecure-random-u64" (func $iru (result i64)))
  (import "wasi:random/insecure@@VERSION@" "get-insecure-random-bytes" (func $irb (param i64 i32)))
  (import "wasi:random/insecure-seed@@VERSION@" "insecure-seed" (func $seed (param i32)))
  (memory (export "memory") 2)
  (data (i32.const 512) "{\"i\":")
  (data (i32.const 520) ",\"s\":")
  (data (i32.const 528) ",\"t\":")
  (data (i32.const 536) ",\"b\":")
  (data (i32.const 544) "}")
  (global $heap (mut i32) (i32.const 4096))
  (global $w (mut i32) (i32.const 0))

  (func (export "cabi_realloc") (param $old i32) (param $oldsz i32) (param $align i32) (param $new i32) (result i32)
    (local $p i32)
    (local.set $p (global.get $heap))
    (global.set $heap (i32.add (local.get $p) (local.get $new)))
    (local.get $p))

  (func $copy (param $src i32) (param $n i32)
    (local $i i32)
    (block $done
      (loop $l
        (br_if $done (i32.ge_u (local.get $i) (local.get $n)))
        (i32.store8 (i32.add (global.get $w) (local.get $i))
                    (i32.load8_u (i32.add (local.get $src) (local.get $i))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $l)))
    (global.set $w (i32.add (global.get $w) (local.get $n))))

  (func $u64 (param $v i64)
    (local $n i32) (local $i i32)
    (if (i64.eqz (local.get $v))
      (then (i32.store8 (i32.const 256) (i32.const 48)) (local.set $n (i32.const 1)))
      (else
        (loop $d
          (i32.store8 (i32.add (i32.const 256) (local.get $n))
                      (i32.add (i32.const 48) (i32.wrap_i64 (i64.rem_u (local.get $v) (i64.const 10)))))
          (local.set $n (i32.add (local.get $n) (i32.const 1)))
          (local.set $v (i64.div_u (local.get $v) (i64.const 10)))
          (br_if $d (i64.ne (local.get $v) (i64.const 0))))))
    (local.set $i (local.get $n))
    (block $done
      (loop $l
        (br_if $done (i32.eqz (local.get $i)))
        (local.set $i (i32.sub (local.get $i) (i32.const 1)))
        (i32.store8 (global.get $w) (i32.load8_u (i32.add (i32.const 256) (local.get $i))))
        (global.set $w (i32.add (global.get $w) (i32.const 1)))
        (br $l))))

  (func (export "run") (param $ptr i32) (param $len i32) (result i32)
    (local $start i32)
    (call $seed (i32.const 64))
    (call $irb (i64.const 8) (i32.const 96))
    (global.set $w (i32.const 1024))
    (local.set $start (i32.const 1024))
    (call $copy (i32.const 512) (i32.const 5))
    (call $u64 (call $iru))
    (call $copy (i32.const 520) (i32.const 5))
    (call $u64 (i64.load (i32.const 64)))
    (call $copy (i32.const 528) (i32.const 5))
    (call $u64 (i64.load (i32.const 72)))
    (call $copy (i32.const 536) (i32.const 5))
    (call $u64 (i64.load (i32.load (i32.const 96))))
    (call $copy (i32.const 544) (i32.const 1))
    (i32.store8 (i32.const 32) (i32.const 0))
    (i32.store (i32.const 36) (local.get $start))
    (i32.store (i32.const 40) (i32.sub (global.get $w) (local.get $start)))
    (i32.const 32))

  (func (export "run-deferred") (result i32) (i32.const 0)))
