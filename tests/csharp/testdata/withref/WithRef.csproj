<Project Sdk="Microsoft.NET.Sdk">
  <!--
    hello plus a ProjectReference to a generator-shaped project whose own package is NOT in the lock (cleat#4099). The reference is
    written like the SDK fixtures write theirs (OutputItemType="Analyzer" ReferenceOutputAssembly="false"). Pin-check fixture only.
  -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>withref</AssemblyName>
    <RootNamespace>CleatWorkflowWorld</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RuntimeIdentifier>wasi-wasm</RuntimeIdentifier>
    <UseAppHost>false</UseAppHost>
    <PublishTrimmed>true</PublishTrimmed>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SelfContained>true</SelfContained>
    <DebugType>none</DebugType>
    <CleatEntryPointsFile>$(MSBuildProjectDirectory)/obj/cleat-entry-points.txt</CleatEntryPointsFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BytecodeAlliance.Componentize.DotNet.Wasm.SDK" Version="0.8.0-preview00011" />
    <!-- The host pack follows the build platform: NETCoreSdkPortableRuntimeIdentifier is linux-x64 or linux-arm64 in the container. -->
    <PackageReference Include="runtime.$(NETCoreSdkPortableRuntimeIdentifier).microsoft.dotnet.ilcompiler.llvm" Version="10.0.0-rc.1.26306.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../refgen/Refgen.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <Wit Include="../../../../python-sdk/wit/cleat.wit" World="cleat-workflow" />
  </ItemGroup>

  <!-- Stands in for the SDK generator. One entry name per line, LF, no BOM, a final newline. No Encoding attribute: Encoding="UTF-8" makes MSBuild write a byte-order mark, which the contract forbids and `cleat build` refuses. -->
  <Target Name="CleatWriteEntryPoints" BeforeTargets="CoreCompile">
    <WriteLinesToFile File="$(CleatEntryPointsFile)" Lines="WithRef" Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>
</Project>
