<Project Sdk="Microsoft.NET.Sdk">
  <!--
    A copy of hello with ONE dependency the lock does not pin (cleat#4099). It exists so the pin check has something to refuse, and so
    the next build can prove that a refusal here does not poison the shared cache volume for a project that needs none of it. It is
    never built to a component. Not an example to copy.
  -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>unpinned</AssemblyName>
    <RootNamespace>CleatWorkflowWorld</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RuntimeIdentifier>wasi-wasm</RuntimeIdentifier>
    <UseAppHost>false</UseAppHost>
    <PublishTrimmed>true</PublishTrimmed>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SelfContained>true</SelfContained>
    <DebugType>none</DebugType>
    <CleatEntryPointsFile>$(MSBuildProjectDirectory)/obj/cleat-entry-points.txt</CleatEntryPointsFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BytecodeAlliance.Componentize.DotNet.Wasm.SDK" Version="0.8.0-preview00011" />
    <!-- NOT in toolchain.packages.tsv, on purpose: the known-positive for the pin check (cleat#4099). Newtonsoft.Json is on nuget.org, a feed the lock allows. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <!-- The host pack follows the build platform: NETCoreSdkPortableRuntimeIdentifier is linux-x64 or linux-arm64 in the container. -->
    <PackageReference Include="runtime.$(NETCoreSdkPortableRuntimeIdentifier).microsoft.dotnet.ilcompiler.llvm" Version="10.0.0-rc.1.26306.1" />
  </ItemGroup>

  <ItemGroup>
    <Wit Include="../../../../python-sdk/wit/cleat.wit" World="cleat-workflow" />
  </ItemGroup>

  <!-- Stands in for the SDK generator. One entry name per line, LF, no BOM, a final newline. No Encoding attribute: Encoding="UTF-8" makes MSBuild write a byte-order mark, which the contract forbids and `cleat build` refuses. -->
  <Target Name="CleatWriteEntryPoints" BeforeTargets="CoreCompile">
    <WriteLinesToFile File="$(CleatEntryPointsFile)" Lines="Unpinned" Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>
</Project>
