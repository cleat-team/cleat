# === Database Connection Strings ===
# PostgreSQL connection string for plugin test harness
# CLEAT_TEST_POSTGRES=postgres://localhost:5432/cleat?sslmode=disable

# MySQL connection string (only used when set)
# CLEAT_TEST_MYSQL=root:password@tcp(localhost:3306)/cleat

# MSSQL connection string (only used when set)
# CLEAT_TEST_MSSQL=sqlserver://sa:password@localhost:1433?database=cleat

# === Plugin Configuration ===
# JSON-formatted plugin configuration injected into Environment.Config
# CLEAT_PLUGIN_CONFIG={"log_level":"debug"}

# === Mock Server Overrides ===
# Override the default mock server listening addresses (advanced use only)
# CLEAT_MOCK_LLM_ADDR=localhost:9001
# CLEAT_MOCK_PAGERDUTY_ADDR=localhost:9002
# CLEAT_MOCK_SLACK_ADDR=localhost:9003
# CLEAT_MOCK_KAFKA_ADDR=localhost:9004
