#!/bin/sh
# ---------------------------------------------------------------------------
# Append the two trailers every commit here is expected to carry, so
# `git commit` behaves like `git commit --signoff` plus the stream stamp
# without anyone having to remember either.
#
#   Signed-off-by:  the DCO, enforced by .github/workflows/dco-check.yml
#   Claude-Stream:  who worked, enforced by .github/workflows/stream-trailer-check.yml
#
# Install once per clone:
#
#   git config core.hooksPath .githooks
#
# Git does not track .git/hooks, which is why this lives in the tree and is
# opted into by config rather than installed automatically. Nothing here is
# load-bearing for CI: the workflows above are what actually fail a pull
# request whose commits lack a trailer. This hook only saves you the rewrite
# afterwards.
#
# THE STREAM HALF EXISTS BECAUSE THE CHECK ARRIVED WITHOUT IT. The stream
# check argues for itself by citing this very arrangement -- "the repo's own
# answer to a discipline people have to remember is the DCO arrangement: a
# hook that adds it, a check that enforces it" -- and then shipped only the
# check. Its own measurement of the convention before enforcement was 53%
# compliance; two pull requests went out unmarked on 2026-09-18 for no reason
# other than that nothing added the line.
# ---------------------------------------------------------------------------
set -eu

MSG_FILE=$1
SOURCE=${2-}

# Leave alone the cases where the message is not the author's to certify, or
# where git will rewrite it anyway:
#   merge    — the trailer belongs on the commits being merged, not the merge
#   squash   — likewise; the constituent commits carry their own
# An amend arrives with SOURCE=commit and IS ours to re-sign, so it is not
# excluded here; the --if-exists guard below keeps that idempotent.
case "$SOURCE" in
	merge|squash) exit 0 ;;
esac

NAME=$(git config user.name || true)
EMAIL=$(git config user.email || true)

if [ -z "$NAME" ] || [ -z "$EMAIL" ]; then
	echo "prepare-commit-msg: cannot sign off — git config user.name and" >&2
	echo "user.email must both be set. The DCO certifies who you are, so" >&2
	echo "there is no sensible default to fall back to." >&2
	exit 1
fi

# git interpret-trailers rather than `>> "$MSG_FILE"`: it places the trailer in
# the commit's trailer block, after the body and alongside any Co-Authored-By,
# instead of gluing a line onto whatever the message happened to end with.
# --if-exists doNothing makes this idempotent, so `git commit --signoff`, an
# amend, and a rebase --signoff all stay single-signed.
git interpret-trailers \
	--if-exists doNothing \
	--trailer "Signed-off-by: $NAME <$EMAIL>" \
	--in-place "$MSG_FILE"

# ---------------------------------------------------------------------------
# Claude-Stream: which workstream produced this commit.
#
# Already present -- an explicit --trailer, or an amend of a stamped commit --
# is left exactly as written. The config is a default for commits that do not
# say, not an override of ones that do.
#
# ASK GIT'S OWN TRAILER PARSER WHETHER IT IS ALREADY THERE, NOT A GREP OVER
# THE RAW FILE. cleat#2588, found on #2621's first review round:
# stream-trailer-check.yml reads `%(trailers:key=Claude-Stream,valueonly)`,
# which is git's parser applied to the FINAL PARAGRAPH only -- a line that
# matches "Claude-Stream: ..." anywhere else in the message (the common case
# is a blank line between it and the trailer block at the end) is invisible
# to that reader. A raw grep over the whole file cannot tell the two apart,
# so it was satisfied by exactly that shape, exited early thinking the
# trailer was already there, and the check downstream found nothing --
# stream-trailer-check.yml's own header names the identical failure it sees
# on OTHER commits' messages ("TWO CAUSES, ONE SYMPTOM, DIFFERENT REPAIRS").
#
# `git interpret-trailers --parse` is the same parser: it prints only what
# the final paragraph actually contains as trailers, which is what
# `%(trailers:...)` also reads. Trust that, not a text match.
# ---------------------------------------------------------------------------
if git interpret-trailers --parse "$MSG_FILE" | grep -qiE '^Claude-Stream:[[:space:]]*[^[:space:]]'; then
	exit 0
fi

# The parser does not see one. If a line that LOOKS like one exists anywhere
# in the raw message, this is a MALFORMED message, not an absent trailer --
# but DO NOT REFUSE HERE. cleat#2588's second review round (cleat-review,
# confirmed independently by the coordinator and by this hook's own author
# in a scratch repo): prepare-commit-msg runs BEFORE the commit-message
# editor opens, for every path that could actually repair this --
# `commit --amend` and `rebase -i`'s `reword` both hand the ALREADY-malformed
# message to this hook first, and a hook that exits non-zero here aborts
# before the editor is ever invoked. Refusing at this point does not give
# the author a chance to fix it; it blocks the only paths that could.
# Measured with git 2.50.1: `commit --amend --no-edit` on such a commit was
# refused with HEAD unchanged; a `reword` was refused with the rebase left
# stuck, rescheduled. `--no-verify` skips this hook's sibling commit-msg but
# not this hook, so it does not help either. The only escape from a refusal
# placed here was `--amend -F <already-fixed-file>` -- not "fix the message
# by hand", which is what this warning used to say while refusing to let
# anyone reach the editor to do it.
#
# So: skip stamping (do not add a second, correctly-placed trailer next to
# the broken one -- that would leave two Claude-Stream lines, one of which
# the check still can't read) and let the message through as-is, warning
# rather than failing. `.githooks/commit-msg` runs on the FINAL message,
# after any editor has had its chance, and refuses it there if it is still
# broken -- but not for a pick that opens no editor (below). THIS hook runs
# whenever git actually CREATES the commit -- a cherry-pick, or a rebase
# onto a base that moved -- and only warns, as below; measured, git 2.50.1.
# A pick git fast-forwards, because the parent is unchanged, reuses the
# existing commit object and runs neither hook. In every case an
# already-malformed commit passes through unrefused; CI's Stream Trailer
# Check is the backstop, same as before this fix existed. See commit-msg
# for the refusal and its regression tests.
if grep -qiE '^Claude-Stream:[[:space:]]*[^[:space:]]' "$MSG_FILE"; then
	echo "prepare-commit-msg: warning: this message has a line matching" >&2
	echo "'Claude-Stream: ...' that git's trailer parser does not read as a" >&2
	echo "trailer (it is not in the message's final paragraph). Not stamping" >&2
	echo "over it -- edit the message to fix this. commit-msg refuses it once" >&2
	echo "you're done editing; an unchanged rebase pick or a cherry-pick runs" >&2
	echo "no editor and no commit-msg, so it goes through regardless, and" >&2
	echo "CI's Stream Trailer Check reports it. See .githooks/commit-msg." >&2
	exit 0
fi

STREAM=$(git config cleat.stream || true)

# REFUSED when unset, for the same reason the signoff above is: there is no
# sensible default. A default would not be "unattributed", it would be
# attributed to somebody else -- which is the failure the stream check was
# written after. Two of one session's pull requests went out as `coordinator`,
# and the coordinator session found a red pull request carrying its own name
# that it had not opened.
#
# Per CHECKOUT rather than global, because a stream is a working tree here.
# `git config --local` in a worktree writes the shared repository config, which
# is what you want: every worktree of one checkout belongs to one stream.
# The valid set is READ FROM THE CHECK rather than repeated here -- including
# in the messages below, which is why it is extracted before they are printed.
#
# Two lists would drift, and the drift is silent in the direction that matters:
# a hook with a stale set refuses a value CI would have accepted, or stamps one
# CI will reject, and both look like the hook is broken rather than out of
# date. tests/hooks asserts the alternation appears nowhere in this file.
#
# If the file cannot be read -- a checkout without .github, an editing mistake
# mid-rebase -- validation is SKIPPED rather than the commit refused. CI still
# catches a bad value, and a hook that blocks every commit because it could not
# parse a workflow file is a worse failure than the one it is guarding against.
CHECK_FILE=$(git rev-parse --show-toplevel)/.github/workflows/stream-trailer-check.yml
VALID=''
if [ -r "$CHECK_FILE" ]; then
	VALID=$(sed -n "s/^[[:space:]]*VALID='\(.*\)'[[:space:]]*$/\1/p" "$CHECK_FILE")
fi

if [ -z "$STREAM" ]; then
	echo "prepare-commit-msg: cannot stamp the workstream — git config" >&2
	echo "cleat.stream is not set in this checkout." >&2
	echo "" >&2
	echo "  git config --local cleat.stream <stream>" >&2
	echo "" >&2
	if [ -n "$VALID" ]; then
		echo "where <stream> matches: $VALID" >&2
	else
		echo "for one of the values .github/workflows/stream-trailer-check.yml accepts." >&2
	fi
	echo "" >&2
	echo "There is no default worth falling back to: a wrong value is not" >&2
	echo "'unattributed', it is attributed to another session. See" >&2
	echo "that workflow and WORKSTREAM.md." >&2
	exit 1
fi

if [ -n "$VALID" ] && ! printf '%s' "$STREAM" | grep -Eq "$VALID"; then
	echo "prepare-commit-msg: git config cleat.stream is '$STREAM', which" >&2
	echo "$(basename "$CHECK_FILE") does not accept. Valid values match:" >&2
	echo "  $VALID" >&2
	exit 1
fi

git interpret-trailers \
	--if-exists doNothing \
	--trailer "Claude-Stream: $STREAM" \
	--in-place "$MSG_FILE"
