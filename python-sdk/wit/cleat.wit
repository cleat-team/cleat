/// Cleat Durable Execution WASM host-call interfaces.
///
/// This file defines the WIT (Wasm Interface Types) package for the cleat
/// durable execution framework. Each interface groups related host functions
/// that the WASM runtime provides to guest modules.
package cleat:host-calls;

/// Service call operations: recorded, retried, or heartbeated.
interface durable-call {
    /// Make a durable (deterministically replayed) call to an external service.
    /// Returns the response JSON string on success, or an error string prefixed
    /// with "__CLEAT_ERROR__:" on failure.
    durable-call: func(
        service: string,
        operation: string,
        request: string,
    ) -> string;

    /// Make a durable call with server-side retry policy.
    /// Returns the response JSON string on success, or an error on failure.
    durable-call-retry: func(
        service: string,
        operation: string,
        request: string,
        max-attempts: u64,
        initial-interval-ms: u64,
        backoff-coefficient-100x: u64,
        max-interval-ms: u64,
        non-retryable-errors: string,
    ) -> string;

    /// Make a durable call with periodic heartbeat/progress updates.
    /// Returns the response JSON string on success, or an error on failure.
    durable-call-heartbeat: func(
        service: string,
        operation: string,
        request: string,
        heartbeat-interval-ms: u64,
    ) -> string;
}

/// Timer, clock, random, and log operations.
interface durable-sleep {
    /// Suspend workflow execution for a duration (in milliseconds).
    durable-sleep: func(duration-ms: u64) -> u64;

    /// Get current wall-clock time in milliseconds since Unix epoch.
    durable-now: func() -> u64;

    /// Get a deterministic random 64-bit value.
    durable-random: func() -> u64;

    /// Log a message to the workflow event history.
    durable-log: func(msg: string) -> u64;
}

/// Workflow version introspection.
interface durable-version {
    /// Get the current workflow definition version.
    durable-version: func() -> u64;

    /// Get the minimum supported version for this workflow definition.
    durable-min-version: func() -> u64;
}

/// Workflow lifecycle operations (defer, compaction, cancellation).
interface durable-lifecycle {
    /// Register a deferred cleanup action to run on workflow exit.
    /// Returns the generated defer ID.
    durable-defer: func(desc: string) -> string;

    /// Replace workflow input and restart execution (history compaction).
    durable-continue-as-new: func(input: string) -> u64;

    /// Check if workflow cancellation has been requested.
    /// Returns the cancellation reason string, or empty if not cancelled.
    durable-poll-cancellation: func() -> string;
}

/// Signal send, receive, and correlation operations.
interface durable-signals {
    /// Wait for one or more external signals, with a timeout.
    /// Output buffers kept for multi-return (name + payload).
    durable-await-signals: func(
        names: string,
        timeout-ms: u64,
        sig-name-ptr: u32,
        sig-name-max-len: u32,
        payload-ptr: u32,
        payload-max-len: u32,
    ) -> u64;

    /// Poll for a specific pending signal (non-blocking).
    /// Returns the signal payload, or empty string if none.
    durable-poll-signal: func(name: string) -> string;

    /// Send a signal with correlation and wait for a reply.
    /// Returns the response payload string.
    durable-send-signal-and-wait: func(
        target-run-id: string,
        signal-name: string,
        payload: string,
        timeout-ms: u64,
    ) -> string;

    /// Reply to a correlated signal from within a handler.
    durable-reply-to-signal: func(
        correlation-id: string,
        response: string,
    ) -> u64;

    /// Send a signal to a target workflow (fire-and-forget, recorded).
    durable-signal-workflow: func(
        target-run-id: string,
        signal-name: string,
        payload: string,
    ) -> u64;
}

/// Child workflow spawn and await operations.
interface durable-children {
    /// Start a child workflow instance (async).
    /// Returns the child run ID string.
    durable-child-workflow: func(
        name: string,
        input: string,
    ) -> string;

    /// Wait for a single child workflow to complete.
    /// Returns the child result JSON string.
    durable-await-child: func(run-id: string) -> string;

    /// Wait for multiple child workflows to complete (batch).
    /// Returns the combined results JSON string.
    durable-await-all-children: func(run-ids-json: string) -> string;

    /// Start a child workflow with version, priority, and parent-close-policy options.
    /// Returns the child run ID string.
    durable-child-workflow-with-options: func(
        name: string,
        input: string,
        version: u64,
        priority: u64,
        parent-close-policy: string,
    ) -> string;
}

/// Durable promise create, await, resolve, and reject operations.
interface durable-promises {
    /// Create a durable promise with the given name.
    /// Returns the generated promise ID string.
    durable-create-promise: func(
        name: string,
        ttl-ms: u64,
    ) -> string;

    /// Wait for a durable promise to resolve, with a timeout.
    /// Returns the resolved value string.
    durable-await-promise: func(
        id: string,
        timeout-ms: u64,
    ) -> string;

    /// Resolve a durable promise with a value.
    durable-resolve-promise: func(
        id: string,
        value: string,
    ) -> u64;

    /// Reject a durable promise with an error.
    durable-reject-promise: func(
        id: string,
        error: string,
    ) -> u64;
}

/// Durable distributed lock operations.
interface durable-lock {
    /// Acquire a distributed lock with the given key and TTL.
    durable-acquire-lock: func(key: string, ttl-ms: s64) -> s64;

    /// Release a previously acquired distributed lock.
    durable-release-lock: func(key: string) -> s64;
}

/// Queryable state management.
interface durable-state {
    /// Set a key-value pair in the workflow's queryable state.
    set-query-state: func(key: string, val: string) -> u64;
}

/// Update and query handler registration.
interface durable-handlers {
    /// Register an update handler for external update calls.
    durable-register-update-handler: func(name: string) -> u64;

    /// Register a read-only query handler for external queries.
    durable-register-query-handler: func(name: string) -> u64;
}

/// Fire-and-forget and scheduled messaging.
interface durable-messaging {
    /// Send a fire-and-forget request to an external service.
    durable-send: func(
        service: string,
        operation: string,
        request: string,
    ) -> u64;

    /// Schedule a delayed one-shot invocation.
    durable-schedule-invoke: func(
        service: string,
        operation: string,
        request: string,
        delay-ms: u64,
    ) -> u64;
}

/// Workflow and run identity introspection.
interface durable-identity {
    /// Get the current workflow's unique identifier.
    durable-workflow-id: func() -> string;

    /// Get the current workflow run's unique identifier.
    durable-run-id: func() -> string;
}

/// Plugin host function extension interface.
interface plugin {
    /// Call a plugin host function.
    /// Returns the plugin response JSON string.
    plugin-call: func(
        plugin-name: string,
        function-name: string,
        input: string,
    ) -> string;

    /// Call a streaming plugin host function (for workstream D2b).
    /// Returns the streaming event JSON string.
    plugin-call-streaming: func(
        plugin-name: string,
        function-name: string,
        input: string,
    ) -> string;
}

/// Scoped state / virtual object operations (ABI 2.26-2.28)
interface durable-scope {
    /// Set the virtual object scope.
    /// Returns the previous scope as a JSON string.
    set-scope: func(
        obj-type: string,
        inst-key: string,
    ) -> string;

    /// Get the current virtual object scope.
    /// Output buffers kept for multi-return (obj-type + inst-key).
    get-scope: func(
        obj-type-ptr: u32,
        obj-type-max-len: u32,
        inst-key-ptr: u32,
        inst-key-max-len: u32,
    ) -> u64;

    /// Generate a deterministic UUID from a seed.
    /// Returns the generated UUID string.
    uuid: func(seed: string) -> string;
}

/// State operations (Stream R) (ABI 2.37-2.44)
interface durable-stream-state {
    set-state: func(key: string, val: string) -> u64;
    /// Returns the state value string.
    get-state: func(key: string) -> string;
    delete-state: func(key: string) -> u64;
    incr-state: func(key: string, delta: u64) -> u64;
    has-state: func(key: string) -> u64;
    /// Returns the list of keys as a JSON array string.
    list-state: func(prefix: string) -> string;
}

/// Extended lifecycle (ABI 2.15)
interface durable-extended-lifecycle {
    /// Continue as new with an explicit version.
    continue-as-new-versioned: func(
        input: string,
        new-version: u32,
    ) -> u64;

    /// Record non-deterministic computation result in event history.
    /// Returns the previously recorded result on replay.
    side-effect: func(value: string) -> string;
}

/// Extended child workflow operations (ABI 2.10)
interface durable-extended-children {
    /// Start a child workflow in a different schema (cross-instance cooperation).
    /// Returns the child run ID string.
    child-workflow-in-schema: func(
        schema: string,
        name: string,
        input: string,
        version: u64,
        priority: u64,
        policy: string,
    ) -> string;
}

/// HTTP fetch (ABI 2.45)
interface durable-fetch {
    /// Perform a durable HTTP fetch.
    /// Returns the response JSON string (status, headers, body).
    fetch: func(
        method: string,
        url: string,
        headers: string,
        body: string,
    ) -> string;
}

/// Recurring workflow triggers.
///
/// Mirrors HostCalls.ScheduleCron / DeleteCron / ListCrons in the Go SDK
/// (cleat/runtime.go) and cleat_schedule_cron / cleat_delete_cron /
/// cleat_list_crons on the ABI. The engine owns the schedule; the workflow
/// only registers and removes them.
///
/// Delivery is at-least-once: a firing may be delivered more than once and
/// will not be silently skipped. See tiers.yaml, workflow-callable-cron.
interface durable-cron {
    /// Register a recurring trigger for another workflow.
    ///
    /// ``timezone`` is an IANA name ("Europe/Berlin"); empty means UTC. The
    /// cron expression is evaluated in that zone, not the worker's.
    /// Returns the schedule ID.
    durable-schedule-cron: func(
        workflow-name: string,
        cron-expr: string,
        timezone: string,
        input: string,
    ) -> string;

    /// Remove a recurring trigger by schedule ID.
    durable-delete-cron: func(schedule-id: string);

    /// List this tenant's recurring triggers as a JSON array.
    durable-list-crons: func() -> string;
}

/// World definition for a cleat workflow WASM component.
///
/// A cleat workflow component imports all host-call interfaces and
/// exports a single ``run`` entry point.
world cleat-workflow {
    import durable-call;
    import durable-sleep;
    import durable-version;
    import durable-lifecycle;
    import durable-signals;
    import durable-children;
    import durable-promises;
    import durable-state;
    import durable-handlers;
    import durable-messaging;
    import durable-identity;
    import plugin;
    import durable-lock;
    import durable-scope;
    import durable-stream-state;
    import durable-extended-lifecycle;
    import durable-extended-children;
    import durable-fetch;
    import durable-cron;

    /// Main workflow entry point.
    ///
    /// ``args`` is the serialised workflow input JSON. The canonical ABI
    /// handles lifting/lowering the string through linear memory.
    /// Returns the serialised workflow result JSON.
    export run: func(args: string) -> string;
}
