# /etc/cleat/cleat-worker.env
#
# Installed as a config file by the .deb package (dpkg will not overwrite a
# locally-modified copy on upgrade). Fill in a database and, if needed,
# additional worker flags, then:
#
#   systemctl enable --now cleat-worker
#
# CLEAT_DATABASE_URL is read directly by cleat-worker when --db is not given
# (cmd/cleat-worker/config.go, resolveDBURL) -- NOT the generic DATABASE_URL;
# see that function's comment for why the name is namespaced.
CLEAT_DATABASE_URL=

# The unit runs `cleat-worker --migrate-only $CLEAT_WORKER_ARGS` before it starts the
# worker (ExecStartPre): a worker no longer migrates the database itself, it only
# verifies the schema (cleat#2117). So --db / --migrate-db here are used for BOTH --
# put a role with DDL rights in --migrate-db if the runtime role in --db has none.
#
# Any other cleat-worker flag, space-separated, e.g.:
#   CLEAT_WORKER_ARGS=--api-addr :8080 --migrate-db postgres://cleat_migrator@host/cleat --concurrency 20
CLEAT_WORKER_ARGS=
