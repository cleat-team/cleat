# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
ast_demo
ast_demo_v2
/cleat-gen
/cleat-worker

# Node/Svelte
web/node_modules/
web/dist/

# Rust build artifacts
**/target/
**/Cargo.lock

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Build output directories
/tmp/out/
/out/

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env

# Editor/IDE
.idea/
.vscode/
.claude/scheduled_tasks.lock
*.swp
*.swo
*~

# macOS
.DS_Store

/cleat-bench

# Python cache
__pycache__/
*.pyc
.pytest_cache/
htmlcov/

# Node modules
node_modules/
ports-round2/*/node_modules/
packages/*/node_modules/
ports-round2/*/package-lock.json
ports-round2/*/dist/

# Generated WASM binaries in examples
examples/*/dist/*.wasm

# Cloned source repos (not our work product)
ports-round2/dbos-demo-apps/
ports-round2/examples/
ports-round2/samples-go/
ports-round2/samples-python/

# Rust build artifacts in ports
ports-round2/*/target/
ports-round2/*/Cargo.lock

# Go sum files in ports
ports-round2/*/go.sum

# Gradle build in ports
ports-round2/*/gradle/wrapper/gradle-wrapper.jar
ports-round2/*/.gradle/
ports-round2/*/build/

# Benchmark baseline files (CI artifacts, not committed)
.benchmarks/
.claude/worktrees/
/cleatctl

.go-cache/

# Java build artifacts
crates/cleat-java/.gradle/
crates/cleat-java/build/
examples/*/node_modules/

# Gradle build artifacts anywhere (these were being swept into commits from
# examples/ because the rules above were path-specific).
.gradle/
**/.gradle/
examples/*/build/

# CI test-report artifacts (go test -json | tee ...), written into the repo
# root by the workflow steps that check skip budgets.
*-report.json
tier-gate.log

# scripts/tier2-gate.sh output
tier2-gate.log
tier2-gate.json
.tier2-verdict

# ---------------------------------------------------------------------------
# Untracked 2026-08-09 (hotfix/rotate-committed-credential).
#
# Every path below was ALREADY matched by a rule in this file -- `node_modules/`
# at line 66 covers all 445 node_modules entries, `/cleat-worker` at line 13
# covers the root binary. They stayed tracked anyway, because .gitignore does
# not apply to a path git is already tracking: the rule was added after the
# file, and was a silent no-op from the day it landed.
#
# So the rules below are not the fix. `git rm --cached` was the fix; these
# exist to stop the same files coming back. If you add an ignore rule for
# something that is already committed, `git rm --cached` it in the same commit
# or you have changed nothing.
# ---------------------------------------------------------------------------

# Agent/orchestration scratch state. Not referenced by Makefile, CI, or go.mod
# (verified: `git grep -l task_state -- Makefile .github/workflows` is empty).
clew-agent.json
clew-executor.plugin
task_state/
plans/
prompts/
projects/
session-*.json

# Build products. 332 MB of these were tracked in HEAD, including binaries
# built on three different machines (Mach-O arm64 and ELF x86-64 side by side).
bin/
cmd/cleat-worker/cleat-worker
/durable-worker
/durable-bench

# Unreferenced root-level demos carrying `//go:build ignore`, so `go build ./...`
# never saw them and nothing noticed they were dead.
/ast_transform_demo.go
/ast_transform_demo_v2.go
