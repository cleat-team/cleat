<Project Sdk="Microsoft.NET.Sdk">

  <!-- Managed unit tests: everything in src/Runtime has no reference to the generated component bindings, so it
       compiles into this assembly and runs under a plain `dotnet test`. The binding-dependent half (HostCalls) is
       exercised by the engine instead: see ../fixture and README.md. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>Cleat.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../src/Runtime/**/*.cs" Link="SdkRuntime/%(RecursiveDir)%(Filename)%(Extension)" />
    <ProjectReference Include="../../generator/Cleat.Generator.csproj" />
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>CleatRuntimeSrc</_Parameter1>
      <_Parameter2>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../../src/Runtime'))</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.11.0" />
  </ItemGroup>

</Project>
