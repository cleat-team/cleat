{
  "targets": {
    "noCoverage": {
      "transform": [
        "@as-pect/transform"
      ]
    }
  },
  "options": {
    "use": [
      "ASC_WASI=0"
    ],
    "exportRuntime": true,
    "exportStart": "_start",
    "runtime": "stub",
    "outFile": "output.wasm",
    "textFile": "output.wat",
    "optimize": false,
    "paths": {
      "@cleat/sdk": "./assembly"
    }
  },
  "entries": [
    "./node_modules/@as-pect/assembly/assembly/index.ts"
  ]
}
