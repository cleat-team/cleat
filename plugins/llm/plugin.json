{
  "name": "llm",
  "version": "0.1.0",
  "description": "Unified LLM provider interface (OpenAI, Anthropic, Groq, Ollama, Gemini, Mistral)",
  "author": "cleat",

  "types": {
    "message": {
      "type": "object",
      "fields": {
        "role": {
          "type": "string",
          "description": "Message role: system, user, assistant, or tool"
        },
        "content": {
          "type": "string",
          "description": "Message content text",
          "optional": true
        },
        "tool_calls": {
          "type": "array",
          "description": "Tool calls attached to this message",
          "items": { "type": "tool_call" },
          "optional": true
        },
        "tool_call_id": {
          "type": "string",
          "description": "ID of the tool call this message responds to",
          "optional": true
        },
        "name": {
          "type": "string",
          "description": "Name of the tool/function this message is from",
          "optional": true
        }
      }
    },
    "tool": {
      "type": "object",
      "fields": {
        "type": {
          "type": "string",
          "description": "Tool type (currently always \"function\")"
        },
        "function": {
          "type": "object",
          "description": "Function definition",
          "fields": {
            "name": {
              "type": "string",
              "description": "Function name"
            },
            "description": {
              "type": "string",
              "description": "Function description"
            },
            "parameters": {
              "type": "object",
              "description": "JSON Schema parameters for the function"
            }
          }
        }
      }
    },
    "tool_call": {
      "type": "object",
      "fields": {
        "id": {
          "type": "string",
          "description": "Tool call ID"
        },
        "type": {
          "type": "string",
          "description": "Tool call type (currently always \"function\")"
        },
        "function": {
          "type": "object",
          "description": "Function call",
          "fields": {
            "name": {
              "type": "string",
              "description": "Function name"
            },
            "arguments": {
              "type": "string",
              "description": "JSON-encoded arguments"
            }
          }
        }
      }
    },
    "usage_info": {
      "type": "object",
      "fields": {
        "prompt_tokens": {
          "type": "int64",
          "description": "Number of tokens in the prompt",
          "optional": true
        },
        "completion_tokens": {
          "type": "int64",
          "description": "Number of tokens generated",
          "optional": true
        },
        "total_tokens": {
          "type": "int64",
          "description": "Total tokens used",
          "optional": true
        }
      }
    },
    "chat_input": {
      "type": "object",
      "fields": {
        "provider": {
          "type": "string",
          "description": "LLM provider name (openai, anthropic, groq, ollama, gemini, mistral)"
        },
        "model": {
          "type": "string",
          "description": "Model identifier"
        },
        "messages": {
          "type": "array",
          "description": "Array of message objects",
          "items": { "type": "message" }
        },
        "temperature": {
          "type": "float64",
          "description": "Sampling temperature (0.0 to 2.0)",
          "optional": true
        },
        "max_tokens": {
          "type": "int64",
          "description": "Maximum tokens to generate",
          "optional": true
        },
        "tools": {
          "type": "array",
          "description": "Tool definitions the model may call",
          "items": { "type": "tool" },
          "optional": true
        },
        "tool_choice": {
          "type": "string",
          "description": "Tool choice directive (auto, any, none, or specific tool name)",
          "optional": true
        },
        "system": {
          "type": "string",
          "description": "System prompt",
          "optional": true
        },
        "api_key": {
          "type": "string",
          "description": "Secret reference (${secret:NAME}) to use for this call instead of the configured provider key (cleat#1988). Must be exactly a secret reference; a literal value is rejected before this reaches event history (cleat#2043).",
          "optional": true
        }
      }
    },
    "choice": {
      "type": "object",
      "fields": {
        "message": {
          "type": "object",
          "description": "The message for this choice",
          "fields": {
            "role": {
              "type": "string",
              "description": "Message role"
            },
            "content": {
              "type": "string",
              "description": "Message content text"
            },
            "tool_calls": {
              "type": "array",
              "description": "Tool calls in this message",
              "items": { "type": "tool_call" },
              "optional": true
            }
          }
        },
        "finish_reason": {
          "type": "string",
          "description": "Finish reason (stop, length, tool_calls, content_filter)"
        }
      }
    },
    "chat_output": {
      "type": "object",
      "fields": {
        "choices": {
          "type": "array",
          "description": "Completion choices returned by the model",
          "items": { "type": "choice" }
        },
        "usage": {
          "type": "object",
          "description": "Token usage info",
          "fields": {
            "prompt_tokens": { "type": "int64", "optional": true },
            "completion_tokens": { "type": "int64", "optional": true },
            "total_tokens": { "type": "int64", "optional": true }
          }
        },
        "cost": {
          "type": "float64",
          "description": "Estimated cost of this call in USD"
        },
        "model": {
          "type": "string",
          "description": "Model that produced the response"
        },
        "error": {
          "type": "string",
          "description": "Error message on failure",
          "optional": true
        },
        "estimated_cost": {
          "type": "bool",
          "description": "True when the model was not in cleat's price table, so cost was computed at the provider's highest known rate rather than an exact one (cleat#2572)",
          "optional": true
        }
      }
    },
    "embed_input": {
      "type": "object",
      "fields": {
        "provider": {
          "type": "string",
          "description": "LLM provider name"
        },
        "model": {
          "type": "string",
          "description": "Embedding model identifier"
        },
        "input": {
          "type": "array",
          "description": "Array of input texts to embed",
          "items": { "type": "string" }
        }
      }
    },
    "embedding_data": {
      "type": "object",
      "fields": {
        "embedding": {
          "type": "array",
          "description": "Embedding vector",
          "items": { "type": "float64" }
        },
        "index": {
          "type": "int64",
          "description": "Index of this embedding in the input array"
        }
      }
    },
    "embed_output": {
      "type": "object",
      "fields": {
        "data": {
          "type": "array",
          "description": "Embedding data",
          "items": { "type": "embedding_data" }
        },
        "usage": {
          "type": "object",
          "description": "Token usage info",
          "fields": {
            "prompt_tokens": { "type": "int64", "optional": true },
            "completion_tokens": { "type": "int64", "optional": true },
            "total_tokens": { "type": "int64", "optional": true }
          }
        },
        "cost": {
          "type": "float64",
          "description": "Estimated cost of this call in USD"
        },
        "error": {
          "type": "string",
          "description": "Error message on failure",
          "optional": true
        }
      }
    },
    "list_models_input": {
      "type": "object",
      "fields": {
        "provider": {
          "type": "string",
          "description": "Provider name filter (empty = all providers)",
          "optional": true
        }
      }
    },
    "list_models_output": {
      "type": "object",
      "fields": {
        "models": {
          "type": "array",
          "description": "Model list (when a specific provider is queried)",
          "items": { "type": "object" },
          "optional": true
        },
        "providers": {
          "type": "object",
          "description": "Provider-to-models map (when no specific provider is queried)",
          "optional": true
        }
      }
    }
  },

  "host_functions": {
    "chat": {
      "description": "Send a chat completion request to an LLM provider",
      "input": { "type": "chat_input" },
      "output": { "type": "chat_output" }
    },
    "chat_stream": {
      "description": "Stream a chat completion from an LLM provider (server-sent events)",
      "input": { "type": "chat_input" },
      "output": { "type": "chat_output" },
      "streaming": true
    },
    "embed": {
      "description": "Generate embeddings for input texts",
      "input": { "type": "embed_input" },
      "output": { "type": "embed_output" },
      "idempotent": true
    },
    "list_models": {
      "description": "List available models from one or all configured LLM providers",
      "input": { "type": "list_models_input" },
      "output": { "type": "list_models_output" },
      "idempotent": true
    }
  }
}
